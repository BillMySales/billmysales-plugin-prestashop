{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "order": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "current_state": {
                    "$comment": "PrestaShop's own representation: the state id is a string in 8 and an integer in 9.",
                    "type": [
                        "integer",
                        "string"
                    ]
                },
                "total_paid": {
                    "type": "string"
                },
                "reference": {
                    "type": "string"
                },
                "associations": {
                    "type": "object",
                    "properties": {
                        "order_rows": {
                            "type": "array",
                            "minItems": 1
                        }
                    },
                    "required": [
                        "order_rows"
                    ]
                }
            },
            "required": [
                "id",
                "current_state",
                "total_paid",
                "reference",
                "associations"
            ]
        }
    },
    "required": [
        "order"
    ]
}
