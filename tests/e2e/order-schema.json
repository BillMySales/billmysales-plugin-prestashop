    "type": "object",
    "properties": {
        "id": {
            "type": "integer"
        },
        "id_order": {
            "type": "integer"
        },
        "current_state": {
            "type": "integer"
        },
        "total_paid": {
            "type": "string"
        },
        "reference": {
            "type": "string"
        },
        "date_add": {
            "type": "string"
        },
        "detail": {
            "type": "array",
            "minItems": 1
        }
    },
    "required": [
        "id",
        "id_order",
        "current_state",
        "total_paid",
        "reference",
        "detail"
    ]
