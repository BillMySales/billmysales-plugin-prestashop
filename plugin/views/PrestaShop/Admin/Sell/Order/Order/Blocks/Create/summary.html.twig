 *
 * Overrides the "Add new order" form's template, to add the custom billing
 * fields inside the same <form> that submits the order's first state: an
 * order created directly in a state that notifies then carries its billing
 * data in the same request, with nothing left to complete afterwards.
 *
 * "cart_summary_form_rest" is the only block the original template exposes;
 * there is no dedicated block right before "Order state", so the fields end
 * up just after it (still inside the same form, submitted together with
 * the rest of the order's data).
 *#}
{% extends '@!PrestaShop/Admin/Sell/Order/Order/Blocks/Create/summary.html.twig' %}

{% block cart_summary_form_rest %}
    {{ parent() }}
    {{ renderhook('displayAdminOrderCreateFields')|raw }}
{% endblock %}
